# Copie para .env. Nunca envie este arquivo preenchido ao GitHub.
N8N_ENCRYPTION_KEY=
TZ=America/Recife
ENABLE_LIVE_SEARCH=false
ML_ACCESS_TOKEN=
# Conexão OAuth oficial. Preenchido localmente por connect-mercadolivre.sh.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Opcional: serviço externo. Ative apenas após autorizar sua conta no provedor.
AFFILIATE_PROVIDER_ENABLED=false
AFFILIATE_API_KEY=
AFFILIATE_TRACKING_ID=
